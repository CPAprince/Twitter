{# templates/component/_tweet.html.twig #}
<div class="tweet p-3 border-bottom" data-tweet-id="{{ tweet.id }}">
    <div class="d-flex align-items-center mb-1">
        <span class="fw-bold me-2">{{ tweet.author.name }}</span>
        <span class="text-muted">
            · {{ tweet.createdAt|date('H:i') }}
            {% if tweet.updatedAt is defined and tweet.updatedAt|date('U') != tweet.createdAt|date('U') %}
                <span class="text-muted">(edited)</span>
            {% endif %}
        </span>
    </div>

    <div class="tweet-content-display">
        <p class="mb-2">{{ tweet.content }}</p>
    </div>

    <div class="tweet-edit-form" style="display: none;">
        {% include 'component/_tweet_form.html.twig' with {
            tweetId: tweet.id,
            initialContent: tweet.content,
            formId: 'tweet-edit-form-' ~ tweet.id,
            alertsContainerId: 'tweet-edit-alerts-' ~ tweet.id
        } only %}
    </div>

    <div class="tweet-actions d-flex justify-content-between w-75">
        <div class="d-flex gap-3 align-items-center">
            <button class="btn btn-link btn-sm p-0 tweet-like-btn" 
                    data-tweet-id="{{ tweet.id }}"
                    data-liked="false"
                    type="button"
                    style="text-decoration: none; color: inherit;">
                <i class="far fa-thumbs-up tweet-like-icon"></i>
                <span class="tweet-like-count">{{ tweet.likes ?? 0 }}</span>
            </button>

            <a href="{{ tweetUrl|default('#') }}">
                <i class="fa fa-external-link" aria-hidden="true"></i>
            </a>

            {# Always render edit button, JavaScript will show/hide based on ownership #}
            <button class="btn btn-link btn-sm p-0 tweet-edit-btn"
                    data-tweet-id="{{ tweet.id }}"
                    data-author-id="{{ tweet.author.id }}"
                    style="display: none;">
                <i class="fas fa-edit"></i>
            </button>
        </div>
    </div>
</div>
