{% extends 'base.html.twig' %}

{% block title %}All tweets{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">

            {% include 'partials/_nav.html.twig' %}

            <div class="col-12 col-md-10 offset-md-3">

{#                                <div class="border-bottom p-3">#}
{#                                    <h5 class="mb-0 fw-bold">#}
{#                                        El Presidente <i class="fa-solid fa-circle-check text-primary"></i>#}
{#                                    </h5>#}
{#                                    <p class="mb-2"><em>There some bio text about the greatest El Presidente</em></p>#}
{#                                </div>#}

{#                                <div class="p-3 border-bottom">#}
{#                                    <textarea class="form-control tweet-input mb-3" placeholder="What's happening?" rows="3"></textarea>#}
{#                                    <div class="d-flex justify-content-end">#}
{#                                        <button class="btn btn-primary rounded-pill px-4" type="button" disabled>Tweet</button>#}
{#                                    </div>#}
{#                                </div>#}

                {% if tweets is empty %}
                    <div class="p-3">
                        <div class="alert alert-secondary mb-0">No tweets yet.</div>
                    </div>
                {% else %}
                    <div class="p-3">
                        <h3 class="m-0">Feeds:</h3>
                    </div>
                    {% for tweet in tweets %}
                        <div class="tweet p-3 border-bottom">
                            <div class="d-flex align-items-center mb-1">
                                <span class="fw-bold me-2">{{ tweet.author.name }}</span>
                                <span class="text-muted"> · {{ tweet.createdAt|date('H:i') }}</span>
                            </div>

                            <p class="mb-2">{{ tweet.content }}</p>

                            <div class="tweet-actions d-flex justify-content-between w-75">
                                <div class="d-flex gap-3 align-items-center">
                                    <div>
                                        <i class="far fa-thumbs-up"></i>
                                        <span>{{ tweet.likes ?? 0 }}</span>
                                    </div>
                                    <a href="#">
                                        <i class="fa fa-external-link" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    {% endfor %}
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}
